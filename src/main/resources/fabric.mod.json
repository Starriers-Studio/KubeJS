{
	"schemaVersion": 1,
	"id": "kubejs",
	"version": "${version}",
	"name": "KubeJS",
	"description": "Customize your modpack or server with JavaScript!",
	"authors": [
		"LatvianModder"
	],
	"contact": {
		"sources": "https://github.com/KubeJS-Mods/KubeJS",
